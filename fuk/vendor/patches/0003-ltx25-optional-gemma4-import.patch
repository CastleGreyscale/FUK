-from transformers import Gemma4UnifiedConfig, Gemma4UnifiedForConditionalGeneration, PreTrainedTokenizerFast
+from transformers import PreTrainedTokenizerFast
+
+# FUK patch: LTX-2.5's text encoder needs Gemma4Unified, which does not exist in
+# every transformers release (absent in 5.1.0). This module is imported
+# unconditionally by pipelines/ltx2_audio_video.py, so a missing symbol here
+# takes down the whole LTX-2 import chain — and with it FUK's backend, which
+# imports that pipeline eagerly at startup.
+#
+# Degrade instead of exploding: LTX-2 keeps working on the installed
+# transformers, and only an actual attempt to build an LTX-2.5 text encoder
+# fails, with a message that says what to install. Drop this patch once FUK
+# pins a transformers that ships Gemma4Unified.
+try:
+    from transformers import Gemma4UnifiedConfig, Gemma4UnifiedForConditionalGeneration
+except ImportError as _gemma4_import_error:
+    _GEMMA4_UNAVAILABLE = _gemma4_import_error
+
+    def _raise_gemma4_unavailable(*args, **kwargs):
+        raise ImportError(
+            "LTX-2.5 needs Gemma4Unified from transformers, which this "
+            f"transformers build does not provide ({_GEMMA4_UNAVAILABLE}). "
+            "Upgrade transformers to use LTX-2.5; LTX-2 is unaffected."
+        )
+
+    class Gemma4UnifiedConfig:
+        def __init__(self, *args, **kwargs):
+            _raise_gemma4_unavailable()
+
+    class Gemma4UnifiedForConditionalGeneration(torch.nn.Module):
+        def __init__(self, *args, **kwargs):
+            _raise_gemma4_unavailable()
 
