# Ignore everything by default
*

# Track specific directories
!.gitignore
!README.md
!pyproject.toml
!fuk
!fuk/**
!fuk/fuk/config/**

!fuk/fuk/core/**
!fuk/fuk/ui/**
!fuk/fuk/utils/**
!fuk/fuk/config/**
!docs/MODEL_DOWNLOADER_README.md
!docs/WINDOWS.md
!docs/**
!setup.sh
!start.sh
!download_models.sh

# FUK Web
!web/
!web/*.html
!web/css/
!web/css/**
web/README.md

# Exclude sensitive/cache data
fuk/core/old/
fuk/ui/data/**
fuk/ui/data/votes/up/*
fuk/ui/data/votes/down/*
fuk/testing/
**/*.log
**/*.bak
**/*.backup
**/cache/
**/Cache/
**/*password*
**/*secret*
# Vendor source trees are cloned by setup.sh and stay untracked, but the patches
# FUK applies on top of them must be version-controlled — they are the only
# record of our local fixes, and setup.sh replays them onto a pinned clone.
# Note the glob: `fuk/vendor/` would exclude the directory itself, and git
# cannot re-include anything beneath an excluded directory.
fuk/vendor/*
!fuk/vendor/patches/
fuk/vendor/patches/.orig-*/

# Blender writes a .blend1 beside every file it saves over. They are automatic
# backups of the previous save, so they are pure churn — and large: four of them
# were 8MB between them.
**/*.blend1

# Third-party rigs live here for local use only and are not FUK's to ship:
# newRig/ is an Auto-Rig Pro character (ARP is a commercial addon) plus a
# Gumroad rig whose licence we have not established. 40MB, and none of it is
# needed to build or run the bridge.
fuk/plugins/blender/newRig/

# Derived rigs. Every one of these is rebuilt from Hand.blend by the scripts
# beside it, so only the irreplaceable source (Hand.blend) and the finished rig
# (Hand_OP21_posable.blend) are tracked. See README "OpenPose rigs" for the
# rebuild chain — the order matters.
fuk/plugins/blender/Hand_OP21.blend
fuk/plugins/blender/Hand_OP21_rigged.blend
fuk/plugins/blender/Hand_OP21_anatomical.blend

# Addon archives are build output, not source. A committed zip also goes stale
# silently: the one removed here was five weeks behind and still shipped the
# OpenPose gamma bug, while being the install path the README points at.
fuk/plugins/blender/addons/*.zip
fuk/plugins/blender/*.tar.gzip

**/outputs/
**/venv/
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
pip-wheel-metadata/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual environments
venv/
env/
ENV/
.venv/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~
.project
.pydevproject

# OS
.DS_Store
Thumbs.db
desktop.ini

# FUK specific - Working directories
cache/
renders/
outputs/
projects/*/cache/
projects/*/renders/

# FUK specific - Configuration files (personal settings)
# Actual config files are ignored, .example files are tracked
fuk/config/models.json
fuk/config/defaults.json
fuk/config/tools/*.json
!config/tools/*.json.example
fuk/config/*.json
!config/*.json.example

# Logs
*.log
logs/

# Model files (too large for git)
*.safetensors
*.ckpt
*.pt
*.pth
*.bin
models/

# Generated files
*.pyc
*.pyo
*.pyd

# Test files
.pytest_cache/
.coverage
htmlcov/

# Node.js (for frontend)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Build artifacts
*.so
*.dylib
*.dll
